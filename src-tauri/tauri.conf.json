{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Etchloom",
  "version": "0.1.0",
  "identifier": "com.etchloom.studio",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-desktop.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Etchloom · Digital Classical Printmaking Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon_512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
